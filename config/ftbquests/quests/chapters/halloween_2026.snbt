			y: -9.5d
		}
		{
			dependencies: ["0822814E563A5044"]
			description: ["&fA tradition of this time of year is to curse pumpkins into blood pumpkins. The process is quite simple, as long as someone knows how to draw the right hex with a bucket of blood on a pumpkin, it will become cursed and slowly fill up with mystical blood."]
			entity_vis_size: 1.0f
			id: "6F7D1EDC2EF88924"
			rewards: [{
				id: "0709DE257E26C79B"
				item: "hexerei:blood_bottle"
				random_bonus: 2
				type: "item"
			}]
			size: 1.15d
			tasks: [{
				id: "0625C2DF7C327E98"
				item: "concatenationcore:blood_pumpkin"
				type: "item"
			}]
			x: 2.5d
			y: -0.5d
		}
		{
			dependencies: ["6F7D1EDC2EF88924"]
			description: [
				"&fThe blood pumpkin will slowly fill up with delicious mystical blood over time. This will draw monsters who will try to consume the blood for themselves. Therefore, sanguines will have to protect valiently their blood pumpkins during the festival. Turns out, there's also all sorts of creatures that don't exactly want to eat this pumpkin, but want to destroy it to prevent accumulation of stronger predators."
				""
				"{@pagebreak}"
				"&fOnce it's full, the blood pumpkin can be broken to yield some goodies, even crystalized gems such as diamonds somehow. It can also result in a net blood positive by pressing blood bubbles into blood bottles. The skin of this pumpkin is now very tough as well."
			]
			entity_vis_size: 1.0f
			id: "5C65BB043F4CF436"
			rewards: [{
				count: 10
				id: "139E88C39AFD23A6"
				item: "hexerei:blood_bottle"
				type: "item"
			}]
